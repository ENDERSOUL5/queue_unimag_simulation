{UTF-8}
{********************************************************}
{ MODELO VENSIM - COMEDOR UNIMAGDALENA v2.0              }
{ Traduccion funcionalmente identica al modelo Python    }
{ FSM completa + Frustracion + Colados + Falla biometrica}
{********************************************************}

{--- PARAMETROS DEL MODELO ---}

Beneficiarios=800
	~	Estudiantes
	~	Total de estudiantes con derecho a almuerzo|

Tasa_Llegada_base=9
	~	Estudiantes/Minute
	~	Tasa base para distribucion horaria|

Tasa_asistencia=0.8
	~	dmnl
	~	Porcentaje de beneficiarios que asiste|

Capacidad_Biometrica=5
	~	Estudiantes/Minute
	~	Outflow bajo disponibilidad biometrica|

Capacidad_Manual=2
	~	Estudiantes/Minute
	~	Outflow de respaldo cuando falla biometrico|

Tiempo_reposicion=5
	~	Minute
	~	Latencia de la interrupcion por agotamiento|

Stock_inicial=100
	~	Platos
	~	Stock inicial de platos disponibles|

Stock_Seguridad=10
	~	Platos
	~	Buffer para reducir tiempo de reposicion|

Personal_presente=1
	~	Personas
	~	Binario: 1 = hay personal, 0 = no hay|

Costo_etico=0.5
	~	dmnl
	~	0 = nadie se averguenza, 1 = todos se averguenzan|

Tasa_falla_biometrica=0.1
	~	1/Minute
	~	Probabilidad de fallo por minuto|

Tiempo_cierre=240
	~	Minute
	~	Horario de cierre del comedor|

TIME_STEP=0.125
	~	Minute
	~	Intervalo de simulacion para precision en bloqueos|

Factor_colado=0.5
	~	dmnl
	~	Peso de la frustracion sobre los colados|

Factor_reduccion_frustracion=10
	~	Estudiantes/Minute
	~	Reduccion de frustracion por atencion efectiva|

Factor_escala_frustracion=10
	~	dmnl
	~	Divisor para escalar frustracion en colados|

Tasa_decaimiento_frustracion=0.1
	~	1/Minute
	~	Decaimiento natural de la frustracion (10% por minuto)|

Frustracion_maxima=1000
	~	dmnl
	~	Cap maximo para evitar explosion de frustracion|

Cola_inicial=0
	~	Estudiantes
	~	Beneficiarios en cola al abrir|

{--- DISTRIBUCION HORARIA DE LLEGADAS ---}

Factor_horario= IF THEN ELSE(TIME < 30, 0.2, IF THEN ELSE(TIME < 60, 0.7, IF THEN ELSE(TIME < 90, 1.0, 0.5)))
	~	dmnl
	~	20% lento, 70% pre-pico, 100% pico, 50% bajando|

Tasa_Llegada= Tasa_Llegada_base * Factor_horario * Tasa_asistencia
	~	Estudiantes/Minute
	~	Llegada efectiva segun hora del dia y asistencia|

{--- FALLA BIOMETRICA ---}

Falla_actual= IF THEN ELSE(RANDOM(0, 1) < Tasa_falla_biometrica, 1, 0)
	~	dmnl
	~	1 = falla activa este paso, 0 = funciona|

Personal_activo= MAX(0, Personal_presente - Falla_actual)
	~	Personas
	~	Personal efectivo despues de falla|

{--- FSM: MAQUINA DE ESTADOS ---}

Estado_numerico= IF THEN ELSE(TIME >= Tiempo_cierre, 2, IF THEN ELSE(Reposicion_activa > 0 :OR: Stock_comida <= 0, 1, 0))
	~	dmnl
	~	0=SERVING, 1=REPLENISHING, 2=CERRADO|

Estado_SERVING= IF THEN ELSE(Estado_numerico = 0, 1, 0)
	~	dmnl
	~	1 cuando el sistema opera en regimen normal|

Estado_REPLENISHING= IF THEN ELSE(Estado_numerico = 1, 1, 0)
	~	dmnl
	~	1 cuando el sistema esta en reposicion|

Estado_CERRADO= IF THEN ELSE(Estado_numerico = 2, 1, 0)
	~	dmnl
	~	1 cuando el comedor cerro|

{--- STOCKS PRINCIPALES ---}

Cola_actual= INTEG (Entrada_total - Tasa_Atencion, Cola_inicial)
	~	Estudiantes
	~	Beneficiarios esperando actualmente en la fila|

Stock_comida= INTEG (Recarga_comida - Tasa_Atencion, Stock_inicial)
	~	Platos
	~	Platos disponibles en el comedor|

Reposicion_activa= INTEG (Tasa_Activar_Repo - Tasa_Desactivar_Repo, 0)
	~	dmnl
	~	Indicador de reposicion en curso (0 o 1)|

Frustracion= INTEG (dFrustracion, 0)
	~	dmnl
	~	Nivel acumulado de frustracion por demoras|

Total_atendidos= INTEG (Tasa_Atencion, 0)
	~	Estudiantes
	~	Contador acumulado de personas atendidas|

{--- FLUJOS Y FLUXOS ---}

Beneficiarios_disponibles= MAX(0, Beneficiarios - Total_atendidos)
	~	Estudiantes
	~	Beneficiarios que aun no han sido atendidos|

Espacio_cola= MAX(0, Beneficiarios_disponibles - Cola_actual)
	~	Estudiantes
	~	Espacio disponible en la cola antes de saturacion|

Demora= MAX(0, Cola_actual - Capacidad_Biometrica * Personal_presente)
	~	Estudiantes
	~	Exceso de cola sobre capacidad de atencion|

Tasa_Colados_raw= Costo_etico * (Frustracion / Factor_escala_frustracion) * Factor_colado
	~	Estudiantes/Minute
	~	Tasa bruta de colados por frustracion|

Tasa_Colados= MIN(Tasa_Colados_raw, Cola_actual / TIME_STEP)
	~	Estudiantes/Minute
	~	Colados limitados por poblacion fisicamente presente|

Entrada_total= IF THEN ELSE(Estado_CERRADO = 1, 0, MIN(Tasa_Llegada + Tasa_Colados, Espacio_cola / TIME_STEP))
	~	Estudiantes/Minute
	~	Entrada total: llegadas + colados, cortada en cierre y limitada por aforo|

Tasa_Atencion= IF THEN ELSE(Estado_REPLENISHING = 1, 0, MIN(Capacidad_Biometrica * Personal_activo, MIN(Cola_actual, Beneficiarios_disponibles) / TIME_STEP))
	~	Estudiantes/Minute
	~	Salida: bloqueada en reposicion, limitada por cola y disponibles|

{--- LOGICA DE REPOSICION (EVENTO DISCRETO) ---}

Tasa_Activar_Repo= IF THEN ELSE(Stock_comida <= 0 :AND: Reposicion_activa <= 0, 1 / TIME_STEP, 0)
	~	1/Minute
	~	Trigger: activa reposicion instantaneamente al agotarse stock|

Tasa_Desactivar_Repo= IF THEN ELSE(Reposicion_activa > 0, 1 / Tiempo_reposicion, 0)
	~	1/Minute
	~	Timer: desactiva reposicion tras Tiempo_reposicion minutos|

Reposicion_previo= DELAY FIXED(Reposicion_activa, TIME STEP, 0)
	~	dmnl
	~	Valor de Reposicion_activa en el paso anterior (detector de flanco)|

Termino_repo= IF THEN ELSE(Reposicion_previo > 0 :AND: Reposicion_activa <= 0, 1, 0)
	~	dmnl
	~	1 en el paso exacto donde termina la reposicion|

Recarga_comida= Termino_repo * Stock_inicial / TIME_STEP
	~	Platos/Minute
	~	Pulso de recarga instantanea de stock al terminar reposicion|

{--- ECUACION DE FRUSTRACION ---}

dFrustracion_raw= Demora - (Tasa_Atencion * Factor_reduccion_frustracion) - (Frustracion * Tasa_decaimiento_frustracion)
	~	dmnl/Minute
	~	Cambio bruto de frustracion: demora - reduccion - decaimiento|

dFrustracion= IF THEN ELSE(Frustracion >= Frustracion_maxima, MIN(0, dFrustracion_raw), dFrustracion_raw)
	~	dmnl/Minute
	~	Frustracion con cap maximo: no crece mas alla del limite|

{--- VARIABLES DE MONITOREO ---}

Tiempo_en_servicio= IF THEN ELSE(Estado_SERVING = 1, TIME STEP, 0)
	~	Minute
	~	Acumulador auxiliar para tiempo en cada estado (opcional)|

{********************************************************
	.Control
********************************************************}

FINAL TIME  = 240
	~	Minute
	~	|

INITIAL TIME  = 0
	~	Minute
	~	|

SAVEPER  = TIME STEP
	~	Minute
	~	|

TIME STEP = 0.125
	~	Minute
	~	|

