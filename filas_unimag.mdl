{UTF-8}
Aforo_maximo=150
	~	Estudiantes
	~	Capacidad máxima del comedor antes del bloqueo total|

Capacidad_normal=6
	~	Estudiantes/Minute
	~	Tasa de servicio (Lectura del buffer de salida)|

{ IMPLEMENTACIÓN: Lógica de la Máquina de Estados }

{ ESTADO 3: Entrada bloqueada si la fila está llena para permitir el vaciado real }
Entrada_estudiantes= IF THEN ELSE(Estudiantes en la fila < Aforo_maximo, 10, 0)
	~	Estudiantes/Minute
	~	Evita el 'Entrada = Salida' que causaba la meseta infinita en 150.|

{ ESTADO 1 y 2: El sistema solo permite salida si no está en proceso de reposición }
Estado_sistema= IF THEN ELSE(Reposicion_activa > 0, 0, 1)
	~	dmnl
	~	1 = Servicio Activo, 0 = Agotamiento/Reposición|

Estudiantes en la fila= INTEG (Entrada_estudiantes - Salida_estudiantes, Estudiantes_inicial)
	~	Estudiantes
	~	|

Estudiantes_inicial=5
	~	Estudiantes
	~	|

Llegada_comida_lote= IF THEN ELSE(Reposicion_activa > 0, Stock_inicial / Tiempo_reposicion, 0)
	~	Platos_comida/Minute
	~	|

{ GESTIÓN DE TRANSICIONES DE ESTADO }
Reposicion_activa= INTEG (Tasa_Entrada_Estado - Tasa_Salida_Estado, 0)
	~	dmnl
	~	Variable de estado: >0 indica que el sistema está en 'Estado de Reposición'|

Tasa_Entrada_Estado= IF THEN ELSE(Stock_comida <= 0 :AND: Reposicion_activa <= 0, 1/TIME STEP, 0)
	~	1/Minute
	~	Disparador (Trigger): Transición del Estado de Servicio al de Reposición|

Tasa_Salida_Estado= IF THEN ELSE(Reposicion_activa > 0, 1/Tiempo_reposicion, 0)
	~	1/Minute
	~	Temporizador: Transición de vuelta al Estado de Servicio tras 10 min|

Salida_estudiantes= IF THEN ELSE(Estado_sistema = 1 :AND: Stock_comida > 0, 
                                   MIN(Capacidad_normal, Estudiantes en la fila / TIME STEP), 
                                   0)
	~	Estudiantes/Minute
	~	Solo hay flujo de salida en el 'Estado 1'|

Stock_comida= INTEG (Llegada_comida_lote - Salida_estudiantes, Stock_inicial)
	~	Platos_comida
	~	|

Stock_inicial=50
	~	Platos_comida
	~	|

Tiempo_reposicion=10
	~	Minute
	~	|

********************************************************
	.Control
********************************************************~
FINAL TIME  = 240
	~	Minute
	~	|
INITIAL TIME  = 0
	~	Minute
	~	|
SAVEPER  = TIME STEP 
	~	Minute
	~	|
TIME STEP=0.0625
	~	Minute
	~	|

